# The one front door for every site on this server. Each app joins the
# external `proxy` Docker network under an alias and gets a block below.

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# One security.txt for every site (RFC 9116).
	handle /.well-known/security.txt {
		root * /etc/caddy
		rewrite * /security.txt
		file_server
	}
}

# A private app: only the people the account service lists for it, in its
# APP_ACCESS setting (irmahs-labs/auth), get through. Anyone signed out is
# sent to sign in with Google and back; anyone else sees "This app is
# private". The app can trust X-Auth-User-Id and X-Auth-User-Email: Caddy
# sets them, and strips any a visitor sends. Inside a site block:
#   import admins-only my-app
(admins-only) {
	forward_auth auth:3001 {
		uri /api/access/{args[0]}
		copy_headers X-Auth-User-Id X-Auth-User-Email
	}
}

irmahs.dev {
	import common
	handle {
		reverse_proxy landing-page:3000
	}
}

www.irmahs.dev {
	redir https://irmahs.dev{uri} permanent
}

# The account service every app signs in through (irmahs-labs/auth).
auth.irmahs.dev {
	import common
	handle {
		reverse_proxy auth:3001
	}
}

# What’s in my pantry? (irmahs-labs/pantry-spinner): the app and its /api.
pantry-spinner.irmahs.dev {
	import common
	handle {
		reverse_proxy sleepy-spinner:3000
	}
}

# Album Cover Maker (irmahs-labs/album-cover-maker): a static site, no sign-in.
album-cover-maker.irmahs.dev {
	import common
	handle {
		reverse_proxy album-cover-maker:3000
	}
}

# Irma’s Playground (irmahs-labs/minigames): the games, their /api and /ws.
playground.irmahs.dev {
	import common
	handle {
		reverse_proxy minigames:3000
	}
}

# Its old address, from when it was Mini Games: every link goes to the same
# page on the new one, except carry-over.html, which hands a visitor's saved
# games to the new address on their first visit there.
minigames.irmahs.dev {
	import common
	handle /carry-over.html {
		reverse_proxy minigames:3000
	}
	handle {
		redir https://playground.irmahs.dev{uri} permanent
	}
}

# alma-housila (irmahs-labs/alma-housila, private): only the people listed
# for alma-housila in the account service's APP_ACCESS get in.
alma-housila.irmahs.dev {
	import common
	import admins-only alma-housila
	handle {
		reverse_proxy alma-housila:3000
	}
}

# Irma in Paris (irmahs-labs/irma-in-paris): the app and its /api. Anyone can
# look; only admins add places and photos, which the app checks itself
# with the account service.
irma-in-paris.irmahs.dev {
	import common
	handle {
		reverse_proxy irma-in-paris:3000
	}
}

# Tournament Leaderboard (irmahs-labs/tournament-leaderboard): the Spring Boot app
# and its /api, deployed from the migration branch while the rewrite replaces the
# Vercel site.
tournament-leaderboard.irmahs.dev {
	import common
	handle {
		reverse_proxy tournament-leaderboard:8080
	}
}
